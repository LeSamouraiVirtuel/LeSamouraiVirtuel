rules_version = '2';
// Règles de sécurité de la base Firestore du Village du Pôle (projet village-du-pole).
// À publier dans la console Firebase : Firestore Database → Règles → coller ce fichier → Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    // Le tableau de bord de l'éditeur : seul ce compte Google (adresse vérifiée, connecté avec Google) peut lire
    // les villages de tous les joueurs. Il ne peut rien écrire.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'better.ask.yannis@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Un village valide : uniquement ces champs, avec des types et des tailles bornés (document < 1 Mo).
    function validVillage(d) {
      return d.keys().hasOnly(['save', 'fmt', 'lvl', 't', 'name', 'stats', 'log', 'welcome'])
        && d.keys().hasAll(['save', 'fmt', 'lvl', 't'])
        && d.save is string && d.save.size() <= 700000
        && d.fmt is int && d.fmt >= 5 && d.fmt <= 1000
        && d.lvl is int && d.lvl >= 1 && d.lvl <= 100000
        && d.t is int
        && (!('name' in d) || (d.name is string && d.name.size() <= 40))
        && (!('stats' in d) || (d.stats is map && d.stats.size() <= 80))
        && (!('log' in d) || (d.log is string && d.log.size() <= 250000))
        && (!('welcome' in d) || d.welcome is bool);
    }

    // users/{uid} : chaque joueur lit, écrit et supprime uniquement son propre village.
    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && validVillage(request.resource.data);
      // le bonus de bienvenue ne se touche qu'une fois : « welcome » ne peut jamais repasser à faux
      allow update: if request.auth != null && request.auth.uid == uid && validVillage(request.resource.data)
        && !(resource.data.get('welcome', false) == true && request.resource.data.get('welcome', false) != true);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // track/{uid} : suivi du joueur (fiche, sessions, actions). Écrit par le joueur lui-même pendant qu'il joue,
    // lu UNIQUEMENT par le tableau de bord de l'éditeur (et par le joueur, pour pouvoir tout effacer avec son compte).
    match /track/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.size() <= 60;
      allow delete: if request.auth != null && request.auth.uid == uid;
      match /s/{sid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.size() <= 20;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // purchases/{uid}/… : achats réels validés (plus tard). Écrits UNIQUEMENT par le serveur (Cloud Functions,
    // après vérification du reçu Apple ou Google) : aucun joueur ne peut s'attribuer un achat.
    match /purchases/{uid}/{doc=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // tout le reste est fermé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
